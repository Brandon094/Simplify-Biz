<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.mycompany</groupId>
    <artifactId>ERP-Plus-Business</artifactId>
    <version>2.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <exec.mainClass>com.mycompany.zl_solucion_integral.Main</exec.mainClass>

        <!--
          Carpeta de compilación (target) redirigida FUERA de la carpeta del proyecto.
          Motivo: el proyecto vive en una partición NTFS montada por FUSE (fuseblk).
          Al borrar rápidamente, NTFS-3G deja archivos `.
          fuse_hidden...` colgados y `mvn clean` falla con
          "Failed to delete .../target". Apuntar target a un disco Linux nativo
          (ext4) resuelve el problema de raíz y hace que `mvn clean package`
          funcione siempre. Cambia la ruta si lo prefieres.
        -->
        <target.dir>${user.home}/.m2-tmp/${project.artifactId}/target</target.dir>

        <!--
          Carpeta visible dentro del proyecto donde se copia el JAR final tras
          el `package`, para ejecutarlo como `java -jar dist/ERP-Plus-Business-2.1.0.jar`.
        -->
        <dist.dir>${project.basedir}/dist</dist.dir>
    </properties>

    <dependencies>
        <!-- Apache POI para manejo de Excel -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
        </dependency>

        <!-- SQLite JDBC -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.46.1.0</version>
        </dependency>

        <!--
          Implementación de SLF4J para silenciar el aviso
          "Failed to load class org.slf4j.impl.StaticLoggerBinder" que emite
          sqlite-jdbc al no encontrar un binding de logging.
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
        </dependency>

        <!-- Dependencia de JavaMail -->
        <dependency>
            <groupId>com.sun.mail</groupId>
            <artifactId>javax.mail</artifactId>
            <version>1.6.2</version>
        </dependency>

        <!-- Lombok para facilitar el código -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>

        <!-- FlatLaf para UI Moderna -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.5.1</version>
        </dependency>
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf-extras</artifactId>
            <version>3.5.1</version>
        </dependency>
        <!-- JUnit 5 para Pruebas Automatizadas -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
          Directorio de salida de la compilación, redirigido a disco nativo
          para evitar el fallo de `mvn clean` en particiones NTFS/FUSE.
        -->
        <directory>${target.dir}</directory>
        <plugins>
            <!-- Plugin para ejecutar pruebas automatizadas JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>

            <!-- Plugin para compilar con soporte para versiones recientes de Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                </configuration>
            </plugin>

            <!-- Plugin para crear un JAR ejecutable -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.4.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>com.mycompany.zl_solucion_integral.tools:*</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>com/mycompany/zl_solucion_integral/tools/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${exec.mainClass}</mainClass>
                                    <!--
                                      Habilita el acceso nativo para SQLite (evita el aviso
                                      "Restricted methods will be blocked in a future release"
                                      al cargar la librería nativa de sqlite-jdbc).
                                    -->
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Plugin para copiar el JAR a dist/ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Copia el JAR sombreado resultante a la carpeta dist/ al finalizar -->
                    <!-- el `package`, para ejecutarlo como `java -jar dist/ERP-Plus-Business-2.0.0.jar`. -->
                    <execution>
                        <id>copiar-jar-a-dist</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.basedir}/dist"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar" tofile="${project.basedir}/dist/${project.build.finalName}.jar" overwrite="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <!-- Nota: los artefactos se generan en ${target.dir} (ver <directory>). -->
        <!-- Cliente de compilación con soporte para versiones recientes de Java -->
        <resources>
            <resource>
                <directory>src/main/resources</directory> <!-- Carpeta de recursos -->
            </resource>
        </resources> 
   </build>
    <name>Simplify-Biz</name>
</project>
